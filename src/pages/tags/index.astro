---
// 标签云（PRD F4）：全部标签 + 文章计数，字号分档
import { getTagMap } from '../../utils/content';
import { toAsciiSlug } from '../../utils/slug';
import BaseLayout from '../../layouts/Base.astro';

const tagMap = await getTagMap();
const max = Math.max(1, ...[...tagMap.values()].map((v) => v.length));

// 字号分档：1~3 档按文章数
const fontLevel = (count: number) => (count === 1 ? 1 : count <= 3 ? 2 : count <= 6 ? 3 : 4);
---

<BaseLayout title="标签" description="全部标签">
  <h1 class="page-title fade-up">标签</h1>
  <p class="page-desc fade-up">共 {tagMap.size} 个标签</p>

  <div class="tag-cloud fade-up">
    {
      [...tagMap.entries()]
        .sort((a, b) => b[1].length - a[1].length)
        .map(([tag, posts]) => (
          <a
            href={`/tech_blog/tags/${toAsciiSlug(tag)}/`}
            class={`tag-item level-${fontLevel(posts.length)}`}
          >
            {tag}
            <sup>{posts.length}</sup>
          </a>
        ))
    }
  </div>
</BaseLayout>

<style>
  .page-title {
    margin-bottom: 4px;
  }
  .page-desc {
    color: var(--text-tertiary);
    font-size: 0.85rem;
    margin-top: 0;
  }
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 18px;
    margin-top: 28px;
    align-items: baseline;
  }
  .tag-item {
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-secondary);
    transition: border-color 0.15s, color 0.15s;
  }
  .tag-item:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .tag-item sup {
    color: var(--text-tertiary);
    margin-left: 3px;
  }
  .level-1 { font-size: 0.85rem; }
  .level-2 { font-size: 0.95rem; }
  .level-3 { font-size: 1.1rem; color: var(--text); }
  .level-4 { font-size: 1.25rem; color: var(--text); font-weight: 600; }
</style>
