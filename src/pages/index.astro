---
// 首页（PRD F1）：Hero + 统计 + 置顶卡 + 最新 6 篇 + 合集速览
import { getPublishedPosts, sortWithPinnedFirst, getCollections, getTagMap } from '../utils/content';
import { SITE } from '../config';
import BaseLayout from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';

const posts = await getPublishedPosts();
const pinnedSorted = sortWithPinnedFirst(posts);
const featured = pinnedSorted.find((p) => p.data.pinned) ?? null;
const latest = pinnedSorted.filter((p) => p.id !== featured?.id).slice(0, 6);
const collections = await getCollections();
const tagMap = await getTagMap();
---

<BaseLayout>
  <section class="hero fade-up">
    <p class="hero-tagline">{SITE.tagline}</p>
    <h1 class="hero-title">{SITE.title}</h1>
    <p class="hero-desc">
      这里是 Lian ZhiWei 的个人博客。分享个人学习与工作中值得记录的内容，以及 AI
      时代的一些思考。
    </p>
    <div class="hero-actions">
      <a href="/tech_blog/posts/" class="btn btn-primary">开始阅读</a>
      <a href="/tech_blog/collections/" class="btn">逛逛合集</a>
      <a href="/tech_blog/about/" class="btn">关于我</a>
    </div>
    <div class="stats">
      <div class="stat"><strong>{posts.length}</strong><span>文章</span></div>
      <div class="stat"><strong>{collections.length}</strong><span>合集</span></div>
      <div class="stat"><strong>{tagMap.size}</strong><span>标签</span></div>
    </div>
  </section>

  {
    featured && (
      <section class="section">
        <h2 class="section-title">置顶精选</h2>
        <div class="feature-card card">
          <span class="badge">置顶 · 精选文章</span>
          <h3 class="feature-title">
            <a href={`/tech_blog/posts/${featured.id}/`}>{featured.data.title}</a>
          </h3>
          <p class="feature-desc">{featured.data.description}</p>
          <a class="feature-more" href={`/tech_blog/posts/${featured.id}/`}>
            阅读全文 →
          </a>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="section-head">
      <h2 class="section-title">最新落笔</h2>
      <a href="/tech_blog/posts/" class="section-more">全部文章 →</a>
    </div>
    <div class="post-list">
      {latest.map((p) => <PostRow post={p} pinned={p.data.pinned} />)}
    </div>
  </section>

  {
    collections.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2 class="section-title">合集速览</h2>
          <a href="/tech_blog/collections/" class="section-more">合集书架 →</a>
        </div>
        <div class="collection-shelf">
          {collections.map((c) => (
            <a href={`/tech_blog/collections/${c.slug}/`} class="collection-book card">
              <span class="collection-spine" aria-hidden="true" />
              <span class="collection-book-body">
                <strong>{c.name}</strong>
                <span class="collection-book-meta">
                  {c.postCount > 0 ? `${c.postCount} 篇 · 持续更新` : '待更新'}
                </span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 36px 0 8px;
  }
  .hero-tagline {
    font-family: var(--font-serif);
    letter-spacing: 0.45em;
    font-size: 0.9rem;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .hero-title {
    font-size: 2.2rem;
    margin: 0 0 14px;
  }
  .hero-desc {
    max-width: 560px;
    margin: 0 auto 24px;
    color: var(--text-secondary);
  }
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn {
    padding: 9px 22px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 0.9rem;
    background: var(--bg-card);
    transition: border-color 0.15s, color 0.15s, transform 0.15s;
  }
  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .btn-primary:hover {
    color: #fff;
    filter: brightness(1.08);
  }
  .stats {
    display: flex;
    justify-content: center;
    gap: 48px;
    margin-top: 34px;
  }
  .stat {
    display: flex;
    flex-direction: column;
  }
  .stat strong {
    font-size: 1.5rem;
    font-family: var(--font-mono);
    color: var(--text);
  }
  .stat span {
    font-size: 0.78rem;
    color: var(--text-tertiary);
  }

  .section {
    margin-top: 52px;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .section-title {
    font-size: 1.15rem;
    margin: 0 0 14px;
  }
  .section-more {
    font-size: 0.82rem;
    color: var(--text-tertiary);
  }

  .feature-card {
    margin-top: 4px;
  }
  .feature-title {
    margin: 10px 0 8px;
    font-size: 1.25rem;
  }
  .feature-title a {
    color: inherit;
  }
  .feature-title a:hover {
    color: var(--accent);
  }
  .feature-desc {
    color: var(--text-secondary);
    font-size: 0.92rem;
    margin: 0 0 12px;
  }
  .feature-more {
    font-size: 0.85rem;
    color: var(--accent);
  }

  .post-list {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 4px 16px;
  }

  .collection-shelf {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
  }
  .collection-book {
    display: flex;
    gap: 14px;
    align-items: center;
    color: inherit;
  }
  .collection-book:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .collection-spine {
    width: 8px;
    align-self: stretch;
    border-radius: 4px;
    background: var(--accent);
    opacity: 0.75;
    flex-shrink: 0;
  }
  .collection-book-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .collection-book-body strong {
    font-size: 0.95rem;
  }
  .collection-book-meta {
    font-size: 0.76rem;
    color: var(--text-tertiary);
  }
</style>
