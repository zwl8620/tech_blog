---
// ⌘K 搜索模态框（PRD F6）：Pagefind 懒加载 + 键盘操作 ↑↓/↵/ESC
---

<div class="search-dialog" id="search-dialog" role="dialog" aria-modal="true" aria-label="站内搜索" hidden>
  <div class="search-overlay" data-close></div>
  <div class="search-panel">
    <div class="search-input-row">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="11" cy="11" r="7" />
        <path d="M21 21l-4.35-4.35" />
      </svg>
      <input type="text" id="search-input" placeholder="搜索文章…" autocomplete="off" />
      <span class="search-esc">ESC</span>
    </div>
    <div class="search-results" id="search-results"></div>
    <div class="search-footer">
      <span>↑↓ 切换</span><span>↵ 打开</span><span>ESC 关闭</span>
      <span class="search-brand">搜索</span>
    </div>
  </div>
</div>

<style>
  .search-dialog {
    position: fixed;
    inset: 0;
    z-index: 100;
  }
  .search-dialog[hidden] {
    display: none;
  }
  .search-overlay {
    position: absolute;
    inset: 0;
    background: rgba(20, 19, 17, 0.45);
  }
  .search-panel {
    position: relative;
    max-width: 560px;
    margin: 12vh auto 0;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
  }
  .search-input-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    color: var(--text-tertiary);
  }
  #search-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 1rem;
    font-family: var(--font-sans);
    color: var(--text);
  }
  .search-esc {
    font-size: 0.7rem;
    padding: 2px 7px;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-tertiary);
  }
  .search-results {
    max-height: 50vh;
    overflow-y: auto;
    min-height: 60px;
  }
  .search-results :global(.pagefind-ui__message) { display: none; }
  .search-footer {
    display: flex;
    gap: 16px;
    padding: 10px 18px;
    border-top: 1px solid var(--border);
    font-size: 0.72rem;
    color: var(--text-tertiary);
  }
  .search-brand {
    margin-left: auto;
    letter-spacing: 0.2em;
  }
  :global(.pagefind-ui__result) {
    padding: 10px 18px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
  }
  :global(.pagefind-ui__result:hover),
  :global(.pagefind-ui__result[aria-selected='true']) {
    background: var(--accent-soft);
  }
  :global(.pagefind-ui__result-title) {
    font-size: 0.92rem;
    color: var(--text);
  }
  :global(.pagefind-ui__result-excerpt) {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 2px;
  }
  :global(.pagefind-ui__result-excerpt mark) {
    background: transparent;
    color: var(--accent);
    font-weight: 600;
  }
</style>

<script>
  // Pagefind 懒加载：首次唤起才加载索引（PRD F6 / 性能 §4）
  const dialog = document.getElementById('search-dialog')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsBox = document.getElementById('search-results')!;
  const BASE = '/tech_blog/';

  let pagefind: any = null;
  let selectedIndex = -1;

  async function loadPagefind() {
    if (pagefind) return pagefind;
    pagefind = await import(/* @vite-ignore */ BASE + 'pagefind/pagefind.js');
    await pagefind.options({
      baseUrl: BASE,
      showImages: false,
    });
    return pagefind;
  }

  function open() {
    dialog.hidden = false;
    input.value = '';
    resultsBox.innerHTML = '';
    input.focus();
    loadPagefind().catch(() => {
      resultsBox.innerHTML =
        '<div class="pf-empty">搜索索引需构建后生成：线上站点自动可用；本地体验请先运行 <code>npm run build</code> 再 <code>npm run preview</code></div>';
    });
  }

  function close() {
    dialog.hidden = true;
    selectedIndex = -1;
  }

  function debounce<T extends (...args: any[]) => void>(fn: T, ms: number) {
    let t: ReturnType<typeof setTimeout>;
    return (...args: Parameters<T>) => {
      clearTimeout(t);
      t = setTimeout(() => fn(...args), ms);
    };
  }

  async function runSearch(q: string) {
    if (!pagefind || !q.trim()) {
      resultsBox.innerHTML = '';
      return;
    }
    const search = await pagefind.search(q);
    const results = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));
    if (!results.length) {
      resultsBox.innerHTML = `<div class="pf-empty">没有找到与「${q.replace(/[<>&]/g, '')}」相关的文章</div>`;
      return;
    }
    resultsBox.innerHTML = results
      .map(
        (r: any, i: number) => `
        <a class="pagefind-ui__result" href="${r.url}" data-idx="${i}">
          <div class="pagefind-ui__result-title">${r.meta?.title ?? '无标题'}</div>
          <div class="pagefind-ui__result-excerpt">${r.excerpt}</div>
        </a>`
      )
      .join('');
    selectedIndex = -1;
  }

  const debouncedSearch = debounce(runSearch, 180);

  input.addEventListener('input', () => debouncedSearch(input.value));

  function moveSelection(delta: number) {
    const items = resultsBox.querySelectorAll<HTMLAnchorElement>('.pagefind-ui__result');
    if (!items.length) return;
    items.forEach((el) => el.removeAttribute('aria-selected'));
    selectedIndex = (selectedIndex + delta + items.length) % items.length;
    const target = items[selectedIndex];
    target.setAttribute('aria-selected', 'true');
    target.scrollIntoView({ block: 'nearest' });
  }

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      moveSelection(1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      moveSelection(-1);
    } else if (e.key === 'Enter') {
      const items = resultsBox.querySelectorAll<HTMLAnchorElement>('.pagefind-ui__result');
      const target = items[selectedIndex >= 0 ? selectedIndex : 0];
      if (target) {
        window.location.href = target.href;
        close();
      }
    }
  });

  dialog.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).dataset.close !== undefined) close();
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.hidden ? open() : close();
    } else if (e.key === 'Escape' && !dialog.hidden) {
      close();
    }
  });

  document.getElementById('search-trigger')?.addEventListener('click', open);
</script>

<style>
  .pf-empty {
    padding: 24px 18px;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-tertiary);
    line-height: 1.7;
  }
  .pf-empty code {
    background: var(--bg-code);
    padding: 1px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
  }
</style>
