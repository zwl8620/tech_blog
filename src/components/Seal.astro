---
// 朱砂印章 Logo（PRD F1：印章式 Logo "LZW"）
interface Props {
  size?: number;
}
const { size = 40 } = Astro.props;
---

<svg
  class="seal"
  width={size}
  height={size}
  viewBox="0 0 48 48"
  xmlns="http://www.w3.org/2000/svg"
  aria-label="LZW 印章"
  role="img"
>
  <rect x="2" y="2" width="44" height="44" rx="7" fill="var(--accent)" />
  <rect x="5.5" y="5.5" width="37" height="37" rx="5" fill="none" stroke="#faf8f3" stroke-width="1.6" opacity="0.85" />
  <text
    x="24"
    y="24"
    text-anchor="middle"
    dominant-baseline="central"
    font-family="var(--font-serif)"
    font-size="15"
    font-weight="700"
    fill="#faf8f3"
    letter-spacing="1">LZW</text>
</svg>

<style>
  .seal {
    display: block;
    border-radius: 7px;
  }
</style>
